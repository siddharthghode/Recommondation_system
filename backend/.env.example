# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Use 'db' when running via Docker Compose (matches the PostgreSQL service name)
POSTGRES_DB=library_db
POSTGRES_USER=library_user
POSTGRES_PASSWORD=StrongPass@123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# DJANGO SETTINGS
# -----------------------------------------------------------------------------
# Set to 'False' in production
DEBUG=False

# REQUIRED in production. Generate a secure key using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-very-secure-random-key-in-production

# Set to 'production' to enforce secret key verification
DJANGO_ENV=production

# Comma-separated list of host/domain names that this Django site can serve
# e.g., ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-ec2-ip
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated list of origins authorized to make cross-site HTTP requests
# e.g., CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# -----------------------------------------------------------------------------
# GOOGLE OAUTH CONFIGURATION
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# For local development, OTPs are printed to backend logs (no email sent)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For real email delivery, configure SMTP below and uncomment EMAIL_BACKEND
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
# Local Redis (default):
REDIS_URL=redis://127.0.0.1:6379/1
# For Docker Compose internal network:
# REDIS_URL=redis://redis:6379/1
# For Redis Cloud:
# REDIS_URL=redis://default:<password>@<host>:<port>

