# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Supabase Cloud PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=your-supabase-db-password
POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=5432
# Or specify full connection string:
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# DJANGO SETTINGS
# -----------------------------------------------------------------------------
# Set to 'False' in production
DEBUG=False

# REQUIRED in production. Generate a secure key using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-very-secure-random-key-in-production

# Set to 'production' to enforce secret key verification
DJANGO_ENV=production

# Comma-separated list of host/domain names that this Django site can serve
# e.g., ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-ec2-ip
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated list of origins authorized to make cross-site HTTP requests
# e.g., CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# -----------------------------------------------------------------------------
# GOOGLE OAUTH CONFIGURATION
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Brevo HTTP API - Port 443 HTTPS)
# -----------------------------------------------------------------------------
# In production / Render:
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
BREVO_API_KEY=xkeysib-your-v3-api-key-here
DEFAULT_FROM_EMAIL=your-verified-brevo-email@example.com

# For local offline development (prints OTP to terminal):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
# Local Redis (default):
REDIS_URL=redis://127.0.0.1:6379/1
# For Docker Compose internal network:
# REDIS_URL=redis://redis:6379/1
# For Redis Cloud:
# REDIS_URL=redis://default:<password>@<host>:<port>

