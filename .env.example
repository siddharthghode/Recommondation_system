# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
POSTGRES_DB=library_db
POSTGRES_USER=library_user
POSTGRES_PASSWORD=StrongPass@123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==============================================================================
# DJANGO SETTINGS
# ==============================================================================
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-for-production
DJANGO_ENV=production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# ==============================================================================
# SERVER / PORT CONFIGURATION
# ==============================================================================
FRONTEND_PORT=80

# ==============================================================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================================================================
# EMAIL CONFIGURATION (Brevo HTTP API - Port 443 HTTPS)
# ==============================================================================
# In production / Render:
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
BREVO_API_KEY=xkeysib-your-v3-api-key-here
DEFAULT_FROM_EMAIL=your-verified-brevo-email@example.com

# For local offline development (prints OTP to terminal):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Local Redis (default):
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PORT_HOST=6379
# For Docker Compose internal network:
# REDIS_URL=redis://redis:6379/1
# For Redis Cloud:
# REDIS_URL=redis://default:<password>@<host>:<port>

