# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Default development credentials for local Docker Compose stack
# For production or cloud databases (e.g. Supabase, RDS), update accordingly.
POSTGRES_DB=library_recommondation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass@123
# Use 'db' inside Docker Compose network, or 'localhost' / '127.0.0.1' when running natively
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5433
POSTGRES_SSLMODE=disable

# Optional: Full database connection string override (takes precedence if uncommented)
# DATABASE_URL=postgresql://postgres:pass@123@db:5432/library_recommondation
# For Supabase Cloud PostgreSQL:
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ==============================================================================
# REDIS CONFIGURATION (Caching & Session Storage)
# ==============================================================================
# In Docker Compose, the service name is 'redis'
REDIS_URL=redis://redis:6379/1
REDIS_PORT_HOST=6379
# When running backend natively on host machine (outside Docker):
# REDIS_URL=redis://127.0.0.1:6379/1
# For Redis Cloud:
# REDIS_URL=redis://default:<password>@<host>:<port>

# ==============================================================================
# DJANGO SETTINGS
# ==============================================================================
# Set to 'False' in production
DEBUG=True

# In production, generate a secure 50-character random key using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-local-secret-key-change-in-production-12345

# Set to 'production' to enforce strict security checks
DJANGO_ENV=development

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,testserver

# Comma-separated list of origins authorized to make cross-site HTTP requests (CORS)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://localhost:8081,http://127.0.0.1,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of trusted origins for unsafe HTTP requests (CSRF)
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://localhost:8081,http://127.0.0.1,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Optional: JWT Signing Key (falls back to DJANGO_SECRET_KEY if not specified)
# JWT_SIGNING_KEY=your-jwt-secret-key

# ==============================================================================
# SERVER & PORT CONFIGURATION
# ==============================================================================
# Host port exposed for the Nginx frontend container (change to 8080 if 80 is in use)
FRONTEND_PORT=80

# ==============================================================================
# OPTIONAL INITIAL SUPERUSER CREATION ON STARTUP
# ==============================================================================
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@library.local
# ADMIN_PASSWORD=admin123

# ==============================================================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# ==============================================================================
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@library.local
# ADMIN_PASSWORD=admin123

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
# Local offline development (prints OTP and emails to console stdout):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@library.local

# For Brevo HTTP API (Production - Port 443 HTTPS):
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# BREVO_API_KEY=xkeysib-your-v3-api-key-here
# DEFAULT_FROM_EMAIL=your-verified-brevo-email@example.com

# ==============================================================================
# FRONTEND VITE CONFIGURATION (Optional - for frontend dev server)
# ==============================================================================
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
