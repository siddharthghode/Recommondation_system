# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
POSTGRES_DB=library_db
POSTGRES_USER=library_user
POSTGRES_PASSWORD=StrongPass@123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==============================================================================
# DJANGO SETTINGS
# ==============================================================================
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-for-production
DJANGO_ENV=production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# ==============================================================================
# SERVER / PORT CONFIGURATION
# ==============================================================================
FRONTEND_PORT=80

# ==============================================================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================================================================
# EMAIL CONFIGURATION (SMTP / Gmail)
# ==============================================================================
# For local dev console logging: django.core.mail.backends.console.EmailBackend
# For real email sending: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Local Redis (default):
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PORT_HOST=6379
# For Docker Compose internal network:
# REDIS_URL=redis://redis:6379/1
# For Redis Cloud:
# REDIS_URL=redis://default:<password>@<host>:<port>

