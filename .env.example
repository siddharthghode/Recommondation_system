# ==============================================================================
# DATABASE CONFIGURATION (Local PostgreSQL Docker Service)
# ==============================================================================
# Default development credentials for self-contained local stack
# IMPORTANT: pass@123 is a local development default only. Never use in production!
POSTGRES_DB=library_recommondation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass@123
# Hostname 'db' is used inside Docker Compose network.
# Use 'localhost' when running the Django backend natively on host without Docker.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5433
POSTGRES_SSLMODE=disable

# Optional: Full database connection string override (takes precedence if uncommented)
# DATABASE_URL=postgresql://postgres:pass@123@db:5432/library_recommondation

# ==============================================================================
# REDIS CONFIGURATION (Local Redis Docker Service)
# ==============================================================================
# In Docker Compose, the service name is 'redis'
REDIS_URL=redis://redis:6379/1
REDIS_PORT_HOST=6379
# When running backend natively on host machine (outside Docker):
# REDIS_URL=redis://127.0.0.1:6379/1

# ==============================================================================
# DJANGO SETTINGS
# ==============================================================================
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-local-secret-key-change-in-production-12345
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,testserver
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://localhost:8081,http://127.0.0.1,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://localhost:8081,http://127.0.0.1,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# SERVER / PORT CONFIGURATION
# ==============================================================================
FRONTEND_PORT=80

# ==============================================================================
# OPTIONAL INITIAL SUPERUSER CREATION ON STARTUP
# ==============================================================================
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@library.local
# ADMIN_PASSWORD=admin123

# ==============================================================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# ==============================================================================
GOOGLE_CLIENT_ID=

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
# Local offline development (prints OTP and emails to console stdout):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@library.local

# For Brevo HTTP API (Optional / Production):
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# BREVO_API_KEY=xkeysib-your-v3-api-key-here
# DEFAULT_FROM_EMAIL=your-verified-brevo-email@example.com
